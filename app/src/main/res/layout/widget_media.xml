<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_amoled"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: Cover Art + Track Info -->
    <LinearLayout
        android:id="@+id/top_info_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/cover_container"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_cover_frame">

            <ImageView
                android:id="@+id/iv_album_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Album cover"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/iv_placeholder_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="Music icon"
                android:src="@drawable/ic_disc" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_source_badge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="[ IDLE // READY ]"
                    android:textColor="@android:color/system_accent1_200"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_output_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="monospace"
                    android:text="[ SPK ]"
                    android:textColor="@android:color/system_neutral2_300"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="No active media"
                android:textColor="@android:color/system_neutral1_50"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tap to open player"
                android:textColor="@android:color/system_neutral2_200"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ASCII Progress Line -->
    <TextView
        android:id="@+id/tv_ascii_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:ellipsize="none"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:text="[──────────────────] 00:00"
        android:textColor="@android:color/system_neutral2_400"
        android:textSize="11sp" />

    <!-- Bottom Transport Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_prev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_secondary"
            android:contentDescription="Previous track"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_prev" />

        <ImageButton
            android:id="@+id/btn_play_pause"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1.4"
            android:background="@drawable/bg_btn_play"
            android:contentDescription="Play or Pause"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play" />

        <ImageButton
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_secondary"
            android:contentDescription="Next track"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_next" />

        <ImageButton
            android:id="@+id/btn_output"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_secondary"
            android:contentDescription="Audio output"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_output" />
    </LinearLayout>

</LinearLayout>
