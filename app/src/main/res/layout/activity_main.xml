<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="// ASCII MEDIA WIDGET"
            android:textColor="@android:color/system_accent1_100"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Material You &amp; AMOLED system media controller."
            android:textColor="@android:color/system_neutral2_200"
            android:textSize="14sp" />

        <!-- Permission Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_widget_amoled"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_permission_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="[ STATUS: CHECKING... ]"
                android:textColor="@android:color/system_accent1_100"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Notification Access is required by Android to read active MediaSessions (Spotify, YT Music, Telegram, local players) and display cover art."
                android:textColor="@android:color/system_neutral2_200"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_grant_permission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Open Notification Access Settings" />
        </LinearLayout>

        <!-- Appearance Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_widget_amoled"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="[ APPEARANCE ]"
                android:textColor="@android:color/system_accent1_100"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_amoled_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="Pure AMOLED Black Background (#000000)"
                android:textColor="@android:color/system_neutral1_50" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_monet_cover"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:checked="true"
                android:text="Monet Duotone Cover Art (matches system palette)"
                android:textColor="@android:color/system_neutral1_50" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_apply_widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Apply &amp; Refresh Widget" />

    </LinearLayout>
</ScrollView>
